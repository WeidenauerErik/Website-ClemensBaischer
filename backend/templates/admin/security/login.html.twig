<!doctype html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Admin Login · Baischer Fleischerei &amp; Catering</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        :root { color-scheme: light; }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background: #efece7;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }
        .card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 8px 30px rgba(0,0,0,.08);
            padding: 40px;
            width: 100%;
            max-width: 360px;
        }
        h1 { font-size: 18px; margin: 0 0 24px; color: #2f2f2f; }
        label { display: block; font-size: 13px; color: #5f5f5f; margin-bottom: 6px; }
        input {
            width: 100%;
            box-sizing: border-box;
            padding: 10px 12px;
            margin-bottom: 16px;
            border: 1px solid #d8d4cd;
            border-radius: 6px;
            font-size: 14px;
        }
        button {
            width: 100%;
            padding: 11px;
            background: #2f2f2f;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            cursor: pointer;
        }
        button:hover { background: #454545; }
        .error { color: #b3261e; font-size: 13px; margin-bottom: 16px; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Baischer &middot; Admin</h1>

        {% if error %}
            <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <label for="username">E-Mail</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>

            <label for="password">Passwort</label>
            <input type="password" id="password" name="_password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Anmelden</button>
        </form>
    </div>
</body>
</html>
