# Copy this file to .env and fill in real values before running
# `docker compose up` for production. Never commit the real .env file.

# dev | prod
APP_ENV=prod

# Symfony's APP_SECRET for the backend (generate with e.g.
# `openssl rand -hex 16`). Must stay secret in production.
APP_SECRET=change-me-to-a-random-32-char-hex-string

# PostgreSQL credentials shared between the `database` and `api` services.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
